<template>
  <div class="page">
    <div class="time-display">
      <text class="time-text">{{currentTime}}</text>
    </div>
    <div class="header">
      <text class="title">设备互联</text>
    </div>

    <list class="content" bounces="true">
      <list-item type="status" class="status-card">
        <div class="status-content">
          <text class="status-label">连接状态</text>
          <text class="status-value {{isConnected ? 'connected' : 'disconnected'}}">
            {{isConnected ? '已连接' : '未连接'}}
          </text>
        </div>
      </list-item>

      <list-item type="info" class="info-card">
        <div class="info-content">
          <text class="info-text">设备互联功能允许您通过手机应用远程管理手表上的笔记。</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import interconnect from '@system.interconnect'
import prompt from '@system.prompt'

export default {
  private: {
    connect: null,
    isConnected: false,
    timeUpdateTimer: null,
    currentTime: ''
  },

  onInit() {
    this.updateCurrentTime()
    this.updateTimeDisplay()
    this.initDeviceCommunication()
  },

  onShow() {
    this.updateCurrentTime()
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
    this.updateTimeDisplay()
  },

  onHide() {
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
  },

  onDestroy() {
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
  },

  initDeviceCommunication() {
    this.connect = interconnect.instance()

    this.connect.onopen = (data) => {
      console.log('连接已打开 isReconnected: ', data.isReconnected)
      this.isConnected = true
      if (!data.isReconnected) {
        prompt.showToast({
          message: '已连接到手机',
          duration: 2000
        })
      }
      this.sendNotesPreviews()
    }

    this.connect.onclose = (data) => {
      console.log(`连接已关闭, reason = ${data.data}, code = ${data.code}`)
      this.isConnected = false
    }

    this.connect.onerror = (data) => {
      console.log(`连接错误, errMsg = ${data.data}, errCode = ${data.code}`)
      this.isConnected = false
    }

    this.connect.onmessage = (data) => {
      console.log(`收到手机消息: ${JSON.stringify(data)}`)
      try {
        const message = JSON.parse(data.data)
        this.handleReceivedMessage(message)
      } catch (error) {
        console.error('解析消息失败:', error)
      }
    }
  },

  sendNotesPreviews() {
    if (!this.isConnected || !this.connect) return

    import('../Common/utils.js').then(utils => {
      utils.readMetadata((err, metadata) => {
        if (err) {
          console.error('读取元数据失败，无法发送预览:', err)
          return
        }

        const noteIds = Object.keys(metadata.notes || {})
        if (noteIds.length === 0) {
          this.connect.send({
            data: {
              type: 'notes_preview',
              previews: []
            },
            success: () => { console.log('笔记预览发送成功（空）') },
            fail: (data, code) => { console.log(`发送笔记预览失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          return
        }

        let previews = []
        let loadedCount = 0
        const totalCount = noteIds.length

        noteIds.forEach((noteId) => {
          utils.readNoteFile(noteId, (err, content) => {
            loadedCount++
            const text = (!err && content) ? content : ''
            const parts = text.split('|')[0] || ''
            const preview = parts.length <= 32 ? parts : parts.substring(0, 32)

            previews.push({
              id: noteId,
              preview: preview
            })

            if (loadedCount === totalCount) {
              this.connect.send({
                data: {
                  type: 'notes_preview',
                  previews: previews
                },
                success: () => { console.log('笔记预览发送成功') },
                fail: (data, code) => { console.log(`发送笔记预览失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
              })
            }
          })
        })
      })
    })
  },

  handleReceivedMessage(message) {
    switch (message.type) {
      case 'request_notes_preview':
        this.sendNotesPreviews()
        break
      case 'request_full_note':
        this.sendFullNote(message.noteId)
        break
      case 'update_note':
        this.updateNote(message.noteId, message.content)
        break
      case 'delete_note':
        this.deleteNote(message.noteId)
        break
      case 'create_note':
        this.createNote(message.content)
        break
      default:
        console.log('未知消息类型:', message.type)
    }
  },

  sendFullNote(noteId) {
    if (!this.isConnected || !this.connect) return

    import('../Common/utils.js').then(utils => {
      utils.readNoteFile(noteId, (err, content) => {
        if (err || !content) {
          this.connect.send({
            data: {
              type: 'note_not_found',
              noteId: noteId
            },
            success: () => { console.log('发送笔记不存在消息成功') },
            fail: (data, code) => { console.log(`发送笔记不存在消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          return
        }

        this.connect.send({
          data: {
            type: 'full_note_response',
            noteId: noteId,
            content: content
          },
          success: () => { console.log('完整笔记发送成功') },
          fail: (data, code) => { console.log(`发送完整笔记失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
        })
      })
    })
  },

  updateNote(noteId, content) {
    import('../Common/utils.js').then(utils => {
      utils.saveNoteFile(noteId, content, (err) => {
        if (err) {
          console.error('更新笔记失败:', err)
          this.connect.send({
            data: {
              type: 'update_error',
              noteId: noteId,
              error: err.message
            },
            success: () => { console.log('发送更新错误消息成功') },
            fail: (data, code) => { console.log(`发送更新错误消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        } else {
          console.log('笔记更新成功')
          this.connect.send({
            data: {
              type: 'update_success',
              noteId: noteId
            },
            success: () => { console.log('发送更新成功消息成功') },
            fail: (data, code) => { console.log(`发送更新成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          // 更新元数据中的修改时间
          utils.readMetadata((err, metadata) => {
            if (!err && metadata && metadata.notes && metadata.notes[noteId]) {
              metadata.notes[noteId].modifyTime = Date.now()
              utils.saveMetadata(metadata, () => {})
            }
          })
        }
      })
    })
  },

  deleteNote(noteId) {
    import('../Common/utils.js').then(utils => {
      utils.deleteNoteFile(noteId, (err) => {
        if (err) {
          console.error('删除笔记失败:', err)
          this.connect.send({
            data: {
              type: 'delete_error',
              noteId: noteId,
              error: err.message
            },
            success: () => { console.log('发送删除错误消息成功') },
            fail: (data, code) => { console.log(`发送删除错误消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        } else {
          console.log('笔记删除成功')
          this.connect.send({
            data: {
              type: 'delete_success',
              noteId: noteId
            },
            success: () => { console.log('发送删除成功消息成功') },
            fail: (data, code) => { console.log(`发送删除成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        }
      })
    })
  },

  createNote(content) {
    import('../Common/utils.js').then(utils => {
      const noteId = Date.now().toString()
      utils.saveNoteFile(noteId, content, (err) => {
        if (err) {
          console.error('创建笔记失败:', err)
          this.connect.send({
            data: {
              type: 'create_error',
              noteId: noteId,
              error: err.message
            },
            success: () => { console.log('发送创建错误消息成功') },
            fail: (data, code) => { console.log(`发送创建错误消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        } else {
          console.log('笔记创建成功')
          this.connect.send({
            data: {
              type: 'create_success',
              noteId: noteId
            },
            success: () => { console.log('发送创建成功消息成功') },
            fail: (data, code) => { console.log(`发送创建成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          // 添加到元数据
          utils.readMetadata((err, metadata) => {
            const now = Date.now()
            if (err || !metadata) {
              metadata = { notes: {} }
            }
            metadata.notes[noteId] = {
              createTime: now,
              modifyTime: now
            }
            utils.saveMetadata(metadata, () => {})
          })
        }
      })
    })
  },

  updateCurrentTime() {
    const now = new Date()
    const hour = now.getHours().toString().padStart(2, '0')
    const minute = now.getMinutes().toString().padStart(2, '0')
    this.currentTime = `${hour}:${minute}`
  },

  updateTimeDisplay() {
    this.timeUpdateTimer = setInterval(() => {
      this.updateCurrentTime()
    }, 10000)
  }
}
</script>

<style>
.page {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
}

.time-display {
  height: 24px;
  justify-content: center;
  align-items: center;
  border-radius: 12px;
  margin: 5px;
  padding: 5px;
}

.time-text {
  font-size: 20px;
  font-weight: bold;
  color: #999999;
}

.header {
  height: 60px;
  padding-left: 20px;
  padding-right: 20px;
  border-bottom-width: 2px;
  border-bottom-color: #333333;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 30px;
  color: #ffffff;
}

.content {
  flex-direction: column;
  align-items: center;
  padding: 10px;
  flex: 1;
}

.status-card {
  width: 100%;
  height: 120px;
  background-color: #1f1f1f;
  border-radius: 12px;
  margin-bottom: 10px;
  border: 3px solid rgba(255,255,255,0.06);
}

.status-content {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 20px;
  height: 100%;
}

.status-label {
  font-size: 24px;
  color: #999999;
  margin-bottom: 10px;
}

.status-value {
  font-size: 32px;
  font-weight: bold;
}

.connected {
  color: #4caf50;
}

.disconnected {
  color: #ff5252;
}

.info-card {
  width: 100%;
  height:200px;
  background-color: #1f1f1f;
  border-radius: 12px;
  border: 3px solid rgba(255,255,255,0.06);
}

.info-content {
  flex-direction: column;
  justify-content: center;
  padding: 20px;
}

.info-text {
  font-size: 22px;
  color: #888888;
}
</style>
