<template>
  <div class="page">
    <!-- 添加时间显示 -->
    <div class="time-display" onclick="scrollToTop">
      <text class="time-text">{{currentTime}}</text>
    </div>
    <div class="header">
      <text class="title">笔记</text>
      <div class="header-buttons">
        <div class="settings-btn" onclick="goToSettings">
          <image src="/Common/settings.png" class="settings-icon"></image>
        </div>
        <div class="add-btn" onclick="addNote">
          <text class="add-btn-text">+</text>
        </div>
      </div>
    </div>
    
    <div if="{{isConnected}}" class="conn-banner">
      <text class="conn-banner-text">已连接到手机</text>
    </div>
    
    <list class="note-list" id="noteList" bounces="true">
      <list-item type="note" class="note-item" for="{{(index, note) in notes}}" onclick="editNote(index)">
        <text class="note-text {{note.recovery ? 'recovery-note' : ''}}">{{getPreview(note)}}</text>
        <text class="note-time {{note.recovery ? 'recovery-note-time' : ''}}">{{formatNoteTime(note)}}</text>
      </list-item>
      <list-item type="safe-area" class="safe-area">
      </list-item>
    </list>

    
    <div if="{{notes.length === 0}}" class="empty-tip">
      <text class="empty-tip-text">暂无笔记</text>
    </div>
  
    <!-- 加载提示对话框 -->
    <div class="load-dialog" if="{{showLoading}}">
      <div class="load-content">
        <text class="load-title" style="margin-bottom:0px">加载中</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCachedSettings, addSettingsListener, removeSettingsListener, addNotesListener, removeNotesListener } from '../Common/utils.js'
import { openDoc, locate, loadRange, getRange, setWindow, importTextFile, utf8ByteLength, DEFAULT_SEG_BYTES } from '../Common/textSegments.js'
// 导入设备通信模块
import interconnect from '@system.interconnect'
import prompt from '@system.prompt'

export default {
  private: {
    notes: [],
    loading: false,
    showLoading: false,
    navigationTimer: null,
    // 加载序号：防止并发 loadNotes 的旧结果覆盖新结果（旧结果可能仍带恢复笔记）
    _loadSeq: 0,
    timeDisplayType: 'createTime', // 从设置中读取
    timeUpdateTimer: null,
    currentTime: '', // 添加当前时间变量
    lastSettingsLoad: 0, // 上次加载设置的时间
    settingsChangeHandler: null, // 设置变化监听器引用
    notesChangeHandler: null, // 笔记变化监听器引用
    // 新增设备通信相关属性
    connect: null, // 连接实例
    isConnected: false, // 连接状态
    // ===== 分段传输（协议 v2） =====
    protocolVersion: 2,
    // requestId -> { doc, noteId }，手机按字符区间读取时复用段表，避免每次重扫
    __openDocs: {},
    // 当前分片上传状态；同一时间只允许一个上传
    __upload: null,
    // 请求序号，保证同一毫秒内多次请求也不冲突
    __reqSeq: 0
  },

  onInit() {
    // 保存监听器引用
    this.settingsChangeHandler = this.onSettingsChange.bind(this);
    this.notesChangeHandler = this.onNotesChange.bind(this);
    
    this.loadSettings()
    this.loadNotes()
    // 初始化当前时间
    this.updateCurrentTime()
    // 启动时间更新定时器
    this.updateTimeDisplay()
    // 添加设置变化监听器
    addSettingsListener(this.settingsChangeHandler);
    // 添加笔记变化监听器
    addNotesListener(this.notesChangeHandler);
    
    // 初始化设备通信
    this.initDeviceCommunication();
  },

  onShow() {
    // 每次页面显示时都重新加载设置和笔记列表
    this.loadSettings()
    this.loadNotes()
    // 确保隐藏加载对话框（特别是从edit页面返回时）
    this.showLoading = false;

    // 清除可能存在的跳转定时器
    if (this.navigationTimer) {
      clearTimeout(this.navigationTimer);
      this.navigationTimer = null;
    }

    // 更新当前时间
    this.updateCurrentTime()
    // 清除可能存在的旧时间更新定时器并启动新的定时器
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
    // 启动时间更新定时器
    this.updateTimeDisplay()
  },
  
  // 初始化设备通信
  initDeviceCommunication() {
    // 获取连接实例
    this.connect = interconnect.instance();
    
    // 注册连接状态回调
    this.connect.onopen = (data) => {
      console.log('连接已打开 isReconnected: ', data.isReconnected);
      this.isConnected = true;
      // 连接成功时提示一次
      if (!data.isReconnected) {
        prompt.showToast({
          message: '已连接到手机',
          duration: 2000
        });
      }
      // 自动发送所有笔记的开头部分
      this.sendNotesPreviews();
    };

    this.connect.onclose = (data) => {
      console.log(`连接已关闭, reason = ${data.data}, code = ${data.code}`);
      this.isConnected = false;
      this.__openDocs = {};
      this.cleanupUpload(this.__upload);
    };

    this.connect.onerror = (data) => {
      console.log(`连接错误, errMsg = ${data.data}, errCode = ${data.code}`);
      this.isConnected = false;
      this.__openDocs = {};
      this.cleanupUpload(this.__upload);
    };

    // 注册消息接收回调
    this.connect.onmessage = (data) => {
      console.log(`收到手机消息: ${JSON.stringify(data)}`);
      this.isConnected = true;
      try {
        const message = JSON.parse(data.data);
        this.handleReceivedMessage(message);
      } catch (error) {
        console.error('解析消息失败:', error);
      }
    };
  },

  // 处理收到的消息
  handleReceivedMessage(message) {
    const type = message.type || message.tag
    console.log('处理消息类型:', type)
    switch (type) {
      case 'request_notes_preview':
        console.log('收到请求笔记预览消息')
        this.sendNotesPreviews()
        break
      case 'request_full_note':
        this.sendFullNote(message.noteId)
        break
      case 'note_open':
        this.handleNoteOpen(message)
        break
      case 'note_read':
        this.handleNoteRead(message)
        break
      case 'note_close':
        this.handleNoteClose(message)
        break
      case 'note_write_begin':
        this.handleWriteBegin(message)
        break
      case 'note_write_chunk':
        this.handleWriteChunk(message)
        break
      case 'note_write_commit':
        this.handleWriteCommit(message)
        break
      case 'note_write_abort':
        this.handleWriteAbort(message)
        break
      case 'update_note':
        this.updateNote(message.noteId, message.content)
        break
      case 'delete_note':
        this.deleteNote(message.noteId)
        break
      case 'create_note':
        this.createNote(message.content)
        break
      case '__hs__':
        this.handleHandshake(message)
        break
      default:
        console.log('未知消息类型:', type)
    }
  },

  handleHandshake(message) {
    const count = message.count
    if (count < 2) {
      this.connect.send({
        data: {
          tag: '__hs__',
          count: count + 1
        },
        success: () => { console.log('握手消息发送成功') },
        fail: (data) => { console.log(`发送握手消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
      })
    }
  },

  // 从存储读取所有笔记并发送预览
  sendNotesPreviews() {
    if (!this.connect) return
    this.isConnected = true

    import('../Common/utils.js').then(utils => {
      utils.readMetadata((err, metadata) => {
        if (err) {
          console.error('读取元数据失败，无法发送预览:', err)
          return
        }

        const noteIds = Object.keys(metadata.notes || {})
        if (noteIds.length === 0) {
          this.connect.send({
            data: {
              type: 'notes_preview',
              protocol: this.protocolVersion,
              previews: []
            },
            success: () => { console.log('笔记预览发送成功（空）') },
            fail: (data) => { console.log(`发送笔记预览失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          return
        }

        let previews = []
        let loadedCount = 0
        const totalCount = noteIds.length

        noteIds.forEach((noteId) => {
          utils.readNoteFileHead(noteId, 96, (err, content) => {
            loadedCount++
            const text = (!err && content) ? content : ''
            const parts = text.split('|')[0] || ''
            const preview = parts.length <= 32 ? parts : parts.substring(0, 32)

            previews.push({
              id: noteId,
              preview: preview,
              createTime: (metadata.notes[noteId] && metadata.notes[noteId].createTime) || 0,
              modifyTime: (metadata.notes[noteId] && metadata.notes[noteId].modifyTime) || 0
            })

            if (loadedCount === totalCount) {
              this.connect.send({
                data: {
                  type: 'notes_preview',
                  protocol: this.protocolVersion,
                  previews: previews
                },
                success: () => { console.log('笔记预览发送成功') },
                fail: (data) => { console.log(`发送笔记预览失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
              })
            }
          })
        })
      })
    })
  },

  // 从存储读取完整笔记并发送
  sendFullNote(noteId) {
    if (!this.connect) return
    this.isConnected = true

    import('../Common/utils.js').then(utils => {
      utils.readNoteFile(noteId, (err, content) => {
        if (err || !content) {
          this.connect.send({
            data: {
              type: 'note_not_found',
              noteId: noteId
            },
            success: () => { console.log('发送笔记不存在消息成功') },
            fail: (data) => { console.log(`发送笔记不存在消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          return
        }

        this.connect.send({
          data: {
            type: 'full_note_response',
            noteId: noteId,
            content: content
          },
          success: () => { console.log('完整笔记发送成功') },
          fail: (data) => { console.log(`发送完整笔记失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
        })
      })
    })
  },

  // ===== 协议 v2：按字符区间读取（内部映射到 128 字节文本段） =====

  sendMessage(data, label) {
    if (!this.connect) return
    this.connect.send({
      data: data,
      success: () => {},
      fail: (res) => {
        console.log(`发送${label || (data && data.type) || '消息'}失败, 错误码 = ${res && res.code}`)
      }
    })
  },

  nextRequestId(prefix) {
    this.__reqSeq = (this.__reqSeq || 0) + 1
    return `${prefix}_${Date.now()}_${this.__reqSeq}`
  },

  sendNoteError(requestId, noteId, error) {
    this.sendMessage({
      type: 'note_error',
      requestId: requestId || '',
      noteId: noteId || '',
      error: error || '读取失败'
    }, '分段错误')
  },

  // 打开笔记：只读 idx 建段表（缺失时才扫描重建），不把全文读进内存。
  handleNoteOpen(message) {
    const requestId = message.requestId
    const noteId = message.noteId
    if (!requestId || !noteId) {
      this.sendNoteError(requestId, noteId, '参数错误')
      return
    }
    const uri = `internal://files/note_${noteId}.txt`
    import('@system.file').then(file => {
      const f = file.default || file
      f.get({
        uri: uri,
        success: () => {
          openDoc(uri, DEFAULT_SEG_BYTES, (err, doc) => {
            if (err || !doc) {
              this.sendNoteError(requestId, noteId, err ? (err.message || '打开失败') : '打开失败')
              return
            }
            this.__openDocs[requestId] = { doc, noteId }
            this.sendMessage({
              type: 'note_meta',
              requestId: requestId,
              noteId: noteId,
              segBytes: doc.segBytes,
              totalBytes: doc.totalBytes,
              charCount: doc.charCount,
              segmentCount: doc.segments.length
            }, '笔记元数据')
          })
        },
        fail: () => {
          this.sendMessage({
            type: 'note_not_found',
            requestId: requestId,
            noteId: noteId
          }, '笔记不存在')
        }
      })
    }).catch(err => {
      this.sendNoteError(requestId, noteId, err && err.message ? err.message : '文件系统异常')
    })
  },

  // 手机按 [from, from+count) 字符读取。这里用 locate/loadRange 只加载覆盖到的段，
  // 发完当前窗口后再 setWindow 逐出，避免长笔记常驻内存。
  handleNoteRead(message) {
    const requestId = message.requestId
    const noteId = message.noteId
    if (!requestId || !noteId) {
      this.sendNoteError(requestId, noteId, '参数错误')
      return
    }

    this.withOpenDoc(requestId, noteId, (openErr, entry) => {
      if (openErr || !entry) {
        this.sendNoteError(requestId, noteId, openErr && openErr.message ? openErr.message : '打开失败')
        return
      }
      const doc = entry.doc
      if (!doc || doc.charCount < 0) {
        this.sendNoteError(requestId, noteId, '文档未就绪')
        return
      }

      let from = Math.floor(Number(message.from) || 0)
      if (from < 0) from = 0
      if (from > doc.charCount) from = doc.charCount
      let count = Math.floor(Number(message.count) || 2048)
      if (count < 1) count = 1
      if (count > 8192) count = 8192
      let end = Math.min(doc.charCount, from + count)

      if (from >= doc.charCount) {
        this.sendMessage({
          type: 'note_chunk',
          requestId: requestId,
          noteId: noteId,
          from: from,
          text: '',
          done: true
        }, '笔记分片')
        this.handleNoteClose({ requestId: requestId })
        return
      }

      const locA = locate(doc, from)
      const locB = locate(doc, Math.max(from, end - 1))
      // 多加载一段：用于判断 end 是否把一个代理对（emoji 等）切在两段之间。
      const loadTo = Math.min(doc.segments.length - 1, locB.index + 1)

      loadRange(doc, locA.index, loadTo, (loadErr) => {
        if (loadErr) {
          this.sendNoteError(requestId, noteId, loadErr.message || '读取分段失败')
          return
        }
        let text = getRange(doc, from, end)
        if (end < doc.charCount && text.length > 0) {
          const next = getRange(doc, end, end + 1)
          const last = text.charCodeAt(text.length - 1)
          if (next && next.length > 0 &&
              last >= 0xD800 && last <= 0xDBFF &&
              next.charCodeAt(0) >= 0xDC00 && next.charCodeAt(0) <= 0xDFFF) {
            text += next
            end += 1
          }
        }
        const done = end >= doc.charCount
        this.sendMessage({
          type: 'note_chunk',
          requestId: requestId,
          noteId: noteId,
          from: from,
          text: text,
          done: done
        }, '笔记分片')
        // 只保留当前窗口，干净段下次需要时再从磁盘读
        setWindow(doc, locA.index, locB.index)
        if (done) {
          this.handleNoteClose({ requestId: requestId })
        }
      })
    })
  },

  handleNoteClose(message) {
    if (!message || !message.requestId) return
    delete this.__openDocs[message.requestId]
  },

  withOpenDoc(requestId, noteId, callback) {
    const cached = this.__openDocs[requestId]
    if (cached) {
      callback(null, cached)
      return
    }
    const uri = `internal://files/note_${noteId}.txt`
    openDoc(uri, DEFAULT_SEG_BYTES, (err, doc) => {
      if (err || !doc) {
        callback(err || new Error('打开失败'))
        return
      }
      const entry = { doc: doc, noteId: noteId }
      this.__openDocs[requestId] = entry
      callback(null, entry)
    })
  },

  // ===== 协议 v2：手机分片上传，手环导入为分段笔记 =====

  handleWriteBegin(message) {
    const requestId = message.requestId
    if (!requestId) {
      this.sendNoteError('', message.noteId, '上传请求缺少 requestId')
      return
    }
    // 同一时间只允许一个上传；旧会话直接丢弃，避免临时文件互相覆盖
    this.cleanupUpload(this.__upload)

    const tmpUri = `internal://files/upload_${requestId}.txt`
    const upload = {
      requestId: requestId,
      noteId: message.noteId || null,
      tmpUri: tmpUri,
      expectedBytes: Number(message.totalBytes) || 0,
      expectedChars: Number(message.charCount) || 0,
      bytes: 0,
      chars: 0,
      seq: -1,
      pendingSeq: null,
      chain: Promise.resolve(),
      committing: false
    }
    this.__upload = upload

    import('@system.file').then(file => {
      const f = file.default || file
      const createEmpty = () => {
        f.writeText({
          uri: tmpUri,
          text: '',
          success: () => {
            this.sendMessage({
              type: 'note_write_ready',
              requestId: requestId,
              noteId: upload.noteId || ''
            }, '上传就绪')
          },
          fail: (data, code) => {
            this.failUpload('创建临时文件失败 ' + code)
          }
        })
      }
      f.delete({
        uri: tmpUri,
        success: createEmpty,
        fail: createEmpty
      })
      f.delete({ uri: tmpUri + '.idx', success: () => {}, fail: () => {} })
    }).catch(err => {
      this.failUpload('文件系统异常: ' + (err && err.message ? err.message : err))
    })
  },

  handleWriteChunk(message) {
    const upload = this.__upload
    if (!upload || upload.requestId !== message.requestId) {
      this.sendMessage({
        type: 'note_write_error',
        requestId: message.requestId || '',
        noteId: message.noteId || '',
        error: '上传会话不存在或已结束'
      }, '上传错误')
      return
    }

    const seq = Math.floor(Number(message.seq))
    if (!(seq >= 0)) {
      this.failUpload('分片序号非法')
      return
    }
    // 重传：已经写过的片直接补 ACK，避免重复追加。
    if (seq <= upload.seq) {
      this.sendMessage({ type: 'note_write_ack', requestId: upload.requestId, seq: seq }, '上传 ACK')
      return
    }
    // 正在写同一片（手机超时重传）时忽略，写完后会统一 ACK。
    if (upload.pendingSeq === seq) {
      return
    }
    if (seq !== upload.seq + 1) {
      this.failUpload('分片序号不连续')
      return
    }

    const text = typeof message.text === 'string' ? message.text : ''
    upload.pendingSeq = seq
    upload.chain = upload.chain.then(() => new Promise((resolve) => {
      if (this.__upload !== upload) {
        resolve()
        return
      }
      import('@system.file').then(file => {
        const f = file.default || file
        f.writeText({
          uri: upload.tmpUri,
          text: text,
          append: seq > 0,
          success: () => {
            upload.seq = seq
            upload.pendingSeq = null
            upload.bytes += utf8ByteLength(text)
            upload.chars += text.length
            this.sendMessage({
              type: 'note_write_ack',
              requestId: upload.requestId,
              seq: seq
            }, '上传 ACK')
            resolve()
          },
          fail: (data, code) => {
            upload.pendingSeq = null
            resolve()
            this.failUpload('写入临时文件失败 ' + code)
          }
        })
      }).catch(err => {
        upload.pendingSeq = null
        resolve()
        this.failUpload('文件系统异常: ' + (err && err.message ? err.message : err))
      })
    }))
  },

  handleWriteCommit(message) {
    const upload = this.__upload
    if (!upload || upload.requestId !== message.requestId) {
      this.sendMessage({
        type: 'note_write_error',
        requestId: message.requestId || '',
        noteId: message.noteId || '',
        error: '上传会话不存在或已结束'
      }, '上传错误')
      return
    }
    if (upload.committing) return
    upload.committing = true

    upload.chain.then(() => {
      if (this.__upload !== upload) return
      if (upload.expectedBytes > 0 && upload.bytes !== upload.expectedBytes) {
        this.failUpload(`字节数不一致（收到 ${upload.bytes}，期望 ${upload.expectedBytes}）`)
        return
      }
      if (upload.expectedChars > 0 && upload.chars !== upload.expectedChars) {
        this.failUpload(`字符数不一致（收到 ${upload.chars}，期望 ${upload.expectedChars}）`)
        return
      }

      const noteId = upload.noteId || Date.now().toString()
      const created = !upload.noteId
      const dstUri = `internal://files/note_${noteId}.txt`

      importTextFile(upload.tmpUri, dstUri, DEFAULT_SEG_BYTES, (importErr) => {
        if (this.__upload !== upload) return
        if (importErr) {
          this.failUpload('导入分段失败: ' + (importErr.message || importErr))
          return
        }

        import('../Common/utils.js').then(utils => {
          utils.readMetadata((err, metadata) => {
            if (err || !metadata) metadata = { notes: {} }
            if (!metadata.notes) metadata.notes = {}
            const now = Date.now()
            if (!metadata.notes[noteId]) {
              metadata.notes[noteId] = { createTime: now, modifyTime: now }
            } else {
              metadata.notes[noteId].modifyTime = now
            }
            utils.saveMetadata(metadata, (saveErr) => {
              if (saveErr) {
                this.failUpload('保存元数据失败')
                return
              }
              this.sendMessage({
                type: 'note_write_success',
                requestId: upload.requestId,
                noteId: noteId,
                created: created
              }, '上传成功')
              this.cleanupUpload(upload)
              this.loadNotes()
            })
          })
        }).catch(err => {
          this.failUpload('读取元数据异常: ' + (err && err.message ? err.message : err))
        })
      })
    }).catch((err) => {
      this.failUpload('提交异常: ' + (err && err.message ? err.message : err))
    })
  },

  handleWriteAbort(message) {
    const upload = this.__upload
    if (!upload) return
    if (message && message.requestId && message.requestId !== upload.requestId) return
    this.cleanupUpload(upload)
  },

  failUpload(error) {
    const upload = this.__upload
    if (!upload) return
    this.sendMessage({
      type: 'note_write_error',
      requestId: upload.requestId,
      noteId: upload.noteId || '',
      error: error || '保存失败'
    }, '上传错误')
    this.cleanupUpload(upload)
  },

  cleanupUpload(upload) {
    if (!upload) return
    if (this.__upload === upload) {
      this.__upload = null
    }
    import('@system.file').then(file => {
      const f = file.default || file
      f.delete({ uri: upload.tmpUri, success: () => {}, fail: () => {} })
      f.delete({ uri: upload.tmpUri + '.idx', success: () => {}, fail: () => {} })
    }).catch(() => {})
  },

  // 更新笔记
  updateNote(noteId, content) {
    import('../Common/utils.js').then(utils => {
      utils.saveNoteFile(noteId, content, (err) => {
        if (err) {
          console.error('更新笔记失败:', err)
          this.connect.send({
            data: {
              type: 'update_error',
              noteId: noteId,
              error: err.message
            },
            success: () => { console.log('发送更新错误消息成功') },
            fail: (data) => { console.log(`发送更新错误消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        } else {
          console.log('笔记更新成功')
          this.connect.send({
            data: {
              type: 'update_success',
              noteId: noteId,
              content: content
            },
            success: () => { console.log('发送更新成功消息成功') },
            fail: (data) => { console.log(`发送更新成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          // 更新元数据中的修改时间
          utils.readMetadata((err, metadata) => {
            if (!err && metadata && metadata.notes && metadata.notes[noteId]) {
              metadata.notes[noteId].modifyTime = Date.now()
              utils.saveMetadata(metadata, () => {
                this.loadNotes()
              })
            } else {
              this.loadNotes()
            }
          })
        }
      })
    })
  },

  // 删除笔记
  deleteNote(noteId) {
    import('../Common/utils.js').then(utils => {
      utils.deleteNoteFile(noteId, (err) => {
        if (err) {
          console.error('删除笔记失败:', err)
          this.connect.send({
            data: {
              type: 'delete_error',
              noteId: noteId,
              error: err.message
            },
            success: () => { console.log('发送删除错误消息成功') },
            fail: (data) => { console.log(`发送删除错误消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        } else {
          // 清理元数据
          utils.readMetadata((err, metadata) => {
            if (!err && metadata && metadata.notes) {
              delete metadata.notes[noteId]
              utils.saveMetadata(metadata, () => {
                console.log('笔记删除成功')
                this.connect.send({
                  data: {
                    type: 'delete_success',
                    noteId: noteId
                  },
                  success: () => { console.log('发送删除成功消息成功') },
                  fail: (data) => { console.log(`发送删除成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
                })
                this.loadNotes()
              })
            } else {
              console.log('笔记删除成功')
              this.connect.send({
                data: {
                  type: 'delete_success',
                  noteId: noteId
                },
                success: () => { console.log('发送删除成功消息成功') },
                fail: (data) => { console.log(`发送删除成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
              })
              this.loadNotes()
            }
          })
        }
      })
    })
  },

  // 创建笔记
  createNote(content) {
    import('../Common/utils.js').then(utils => {
      const noteId = Date.now().toString()
      utils.saveNoteFile(noteId, content, (err) => {
        if (err) {
          console.error('创建笔记失败:', err)
          this.connect.send({
            data: {
              type: 'create_error',
              noteId: noteId,
              error: err.message
            },
            success: () => { console.log('发送创建错误消息成功') },
            fail: (data) => { console.log(`发送创建错误消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
        } else {
          console.log('笔记创建成功')
          this.connect.send({
            data: {
              type: 'create_success',
              noteId: noteId,
              content: content
            },
            success: () => { console.log('发送创建成功消息成功') },
            fail: (data) => { console.log(`发送创建成功消息失败, 错误信息 = ${data.data}, 错误码 = ${data.code}`) }
          })
          // 添加到元数据
          utils.readMetadata((err, metadata) => {
            const now = Date.now()
            if (err || !metadata) {
              metadata = { notes: {} }
            }
            metadata.notes[noteId] = {
              createTime: now,
              modifyTime: now
            }
            utils.saveMetadata(metadata, () => {
              this.loadNotes()
            })
          })
        }
      })
    })
  },

  // 清除恢复文件
  clearRecoveryFile() {
    try {
      import('../Common/utils.js').then(utils => {
        utils.clearRecoveryFile((err) => {
          if (err) {
            console.error("清除恢复文件失败:", err);
          } else {
            console.log("恢复文件 recovery.txt 清除成功");
          }
        });
      });
    } catch (error) {
      console.error('清除恢复文件时发生异常:', error);
    }
  },
  
  onHide() {
    // 页面隐藏时清除定时器
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
  },
  
  onDestroy() {
    // 页面销毁时清除定时器
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
    // 释放未完成的分段会话与临时文件
    this.__openDocs = {}
    this.cleanupUpload(this.__upload)
    // 移除设置变化监听器
    if (this.settingsChangeHandler) {
      removeSettingsListener(this.settingsChangeHandler);
      this.settingsChangeHandler = null;
    }
    // 移除笔记变化监听器
    if (this.notesChangeHandler) {
      removeNotesListener(this.notesChangeHandler);
      this.notesChangeHandler = null;
    }
  },
  
  // 设置变化回调
  onSettingsChange(settings) {
    console.log('设置已更改:', settings);
    if (settings && settings.timeDisplayType !== this.timeDisplayType) {
      this.timeDisplayType = settings.timeDisplayType || 'createTime';
      // 重新排序笔记
      this.sortNotes();
    }
  },
  
  // 笔记变化回调
  onNotesChange() {
    console.log('笔记已更改，重新加载笔记列表');
    this.loadNotes();
  },

  loadSettings() {
    getCachedSettings((err, settings) => {
      this.applySettings(settings);
    });
  },
  
  // 应用设置
  applySettings(settings) {
    const oldTimeDisplayType = this.timeDisplayType;
    if (settings) {
      this.timeDisplayType = settings.timeDisplayType || 'createTime';
    } else {
      this.timeDisplayType = 'createTime';
    }
    
    // 如果排序方式改变，重新排序
    if (oldTimeDisplayType !== this.timeDisplayType) {
      this.sortNotes();
    }
  },
  
  loadNotes() {
    // 显示加载提示
    this.loading = true;

    // 每次加载分配一个序号，异步回调返回时若已不是最新一次加载则丢弃，
    // 避免较早发起、较晚返回的读取结果把刚清除的恢复笔记又写回列表
    const loadSeq = (this._loadSeq || 0) + 1;
    this._loadSeq = loadSeq;
    const isStale = () => loadSeq !== this._loadSeq;

    import('../Common/utils.js').then(utils => {
      utils.readMetadata((err, metadata) => {
        if (isStale()) return;
        if (err) {
          console.log("读取元数据失败:", err);
          this.notes = [];
          this.loading = false;
          return;
        }

        // 获取所有笔记（排除恢复笔记标记）
        const noteEntries = Object.entries(metadata.notes || {})
          .filter(([noteData]) => !noteData.recovery) // 过滤掉旧的恢复标记
          .map(([noteId, noteData]) => ({
            id: noteId,
            createTime: noteData.createTime,
            modifyTime: noteData.modifyTime,
            recovery: false
          }));

        // 按时间排序
        noteEntries.sort((a, b) => b.createTime - a.createTime);

        // 逐个读取笔记内容
        let loadedNotes = [];
        let loadedCount = 0;
        const totalCount = noteEntries.length;

        // 先检查 recovery.txt 是否有内容
        utils.readRecoveryFile((recoveryErr, recoveryContent) => {
          if (isStale()) return;
          let hasRecovery = false;
          if (!recoveryErr && recoveryContent && recoveryContent.trim() !== '') {
            hasRecovery = true;
          }

          // 如果没有正常笔记，只有恢复文件
          if (totalCount === 0 && !hasRecovery) {
            this.notes = [];
            this.loading = false;
            return;
          }

          // 如果有恢复文件，添加到笔记列表开头
          if (hasRecovery) {
            const now = Date.now();
            const recoveryTimestamp = now; // 使用当前时间作为恢复笔记的时间
            loadedNotes.push({
              content: recoveryContent,
              originalIndex: -1,
              id: 'recovery',
              createTime: recoveryTimestamp,
              modifyTime: recoveryTimestamp,
              recovery: true
            });
          }

          // 如果没有任何正常笔记，只有恢复文件
          if (totalCount === 0) {
            this.notes = loadedNotes.filter(note => note !== undefined);
            this.loading = false;
            return;
          }

          noteEntries.forEach((noteEntry, index) => {
            // 列表只需预览，读取头部字节即可，避免为预览读入整篇
            utils.readNoteFileHead(noteEntry.id, 96, (err, content) => {
              if (isStale()) return;
              loadedCount++;

              // 调整索引，因为前面可能插入了恢复笔记
              const actualIndex = index + (hasRecovery ? 1 : 0);

              if (!err && content !== undefined) {
                loadedNotes[actualIndex] = {
                  content: `${content}`,
                  originalIndex: index,
                  id: noteEntry.id,
                  createTime: noteEntry.createTime,
                  modifyTime: noteEntry.modifyTime,
                  recovery: false
                };
              } else {
                console.error(`读取笔记 ${noteEntry.id} 失败:`, err);
                loadedNotes[actualIndex] = {
                  content: ``,
                  originalIndex: index,
                  id: noteEntry.id,
                  createTime: noteEntry.createTime,
                  modifyTime: noteEntry.modifyTime,
                  recovery: false
                };
              }

              // 检查是否所有笔记都已加载完成
              if (loadedCount === totalCount) {
                // 过滤掉加载失败的笔记
                this.notes = loadedNotes.filter(note => note !== undefined);
                this.loading = false;
              }
            });
          });
        });
      });
    }).catch(err => {
      if (isStale()) return;
      console.error("导入工具模块失败:", err);
      this.notes = [];
      this.loading = false;
    });
  },

  getPreview(text) {
    // 返回文本的前32个字符
    if (!text) return '';
    // 提取笔记主体内容（去除时间戳部分）
    const parts = text.content.split('|');
    const content = parts[0] || '';
    if (content.length <= 32) return content;
    return content.substring(0, 32);
  },

  // 格式化笔记时间显示
  formatNoteTime(note) {
    // 如果是恢复的笔记，返回特殊标记
    if (note.recovery) {
      return '恢复的笔记';
    }

    // 时间类型
    const timeType = this.timeDisplayType === 'createTime' ? '创建' : '修改';

    // 使用笔记对象中的时间属性
    const createTime = note.createTime;
    const modifyTime = note.modifyTime;
    if (!createTime || !modifyTime) return '没有记录'+ timeType + '时间'; // 如果没有时间信息



    // 根据当前显示类型选择时间
    const time = this.timeDisplayType === 'createTime' ? createTime : modifyTime;

    // 格式化时间显示为 YYMMDD HHMM
    const date = new Date(time);
    const year = (date.getFullYear() % 100).toString().padStart(2, '0');
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    const hour = date.getHours().toString().padStart(2, '0');
    const minute = date.getMinutes().toString().padStart(2, '0');

    return `${year}.${month}.${day} ${hour}:${minute} ${timeType}`;
  },
  
  // 格式化当前时间显示（HH:MM格式）
  updateCurrentTime() {
    const now = new Date();
    const hour = now.getHours().toString().padStart(2, '0');
    const minute = now.getMinutes().toString().padStart(2, '0');
    this.currentTime = `${hour}:${minute}`;
  },
  
  // 更新时间显示
  updateTimeDisplay() {
    this.timeUpdateTimer = setInterval(() => {
      // 更新当前时间
      this.updateCurrentTime();
    }, 10000); 
  },
  
  // 切换时间显示类型
  toggleTimeDisplay() {
    this.timeDisplayType = this.timeDisplayType === 'createTime' ? 'modifyTime' : 'createTime';
    this.sortNotes();
  },
  
  // 按时间排序笔记
  sortNotes() {
    this.notes.sort((a, b) => {
      const partsA = a.content.split('|');
      const partsB = b.content.split('|');
      
      if (partsA.length < 3 || partsB.length < 3) return 0;
      
      const timeA = this.timeDisplayType === 'createTime' 
        ? parseInt(partsA[1]) 
        : parseInt(partsA[2]);
        
      const timeB = this.timeDisplayType === 'createTime' 
        ? parseInt(partsB[1]) 
        : parseInt(partsB[2]);
      
      // 从新到旧排序
      return timeB - timeA;
    });
  },
  
  addNote() {
    // 显示加载提示
    this.showLoading = true;
    
    // 使用setTimeout确保UI更新后才执行跳转，并保存定时器ID以便取消
    this.navigationTimer = setTimeout(() => {
      router.push({
        uri: '/edit',
        params: {
          index: -1,
          content: ''
        }
      })
    }, 100);
  },
  
  editNote(index) {
    // 显示加载提示
    this.showLoading = true;

    const note = this.notes[index];
    
    // 如果是恢复的笔记
    if (note.recovery) {
      // 先从列表移除蓝色恢复项，避免编辑页清理完成前仍能看到它；
      // 若编辑页保存失败，返回时 onShow 重新加载会再次显示
      this.notes = this.notes.filter(n => !n.recovery);
      // 跳转到编辑页面，传递恢复的内容和标记
      this.navigationTimer = setTimeout(() => {
        router.push({
          uri: '/edit',
          params: {
            index: -1,
            content: note.content,
            fromRecovery: true
          }
        });
      }, 100);
      return;
    }

    // 使用setTimeout确保UI更新后才执行跳转，并保存定时器ID以便取消
    this.navigationTimer = setTimeout(() => {
      router.push({
        uri: '/edit',
        params: {
          index: note.originalIndex, // 传递原始索引（兼容删除等逻辑）
          noteId: note.id            // 编辑页据此从磁盘按字节分段加载
        }
      })
    }, 100);
  },
  
  
  // 跳转到设置页面
  goToSettings() {
    router.push({
      uri: '/settings'
    });
  },
  scrollToTop() {
    const scrollElement = this.$element("noteList")
    scrollElement.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
          console.log('滚动执行成功');
  }
}
</script>

<style>
.page {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  overflow-x: hidden;
}

.time-display {
  height: 24px;
  justify-content: center;
  align-items: center;
  border-radius: 12px; /* 添加圆角 */
  margin: 5px;
  padding: 5px;
}

.time-text {
  font-size: 20px;
  font-weight: bold;
  color: #999999;
}

.header {
  height: 60px;
  padding-left: 20px;
  padding-right: 20px;
  border-bottom-width: 2px;
  border-bottom-color: #333333;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 30px;
  color: #ffffff;
}

.header-buttons {
  flex-direction: row;
  align-items: center;
}

.settings-btn,.add-btn {
  width: 50px;
  height: 50px;
  background-color: rgb(38,38,38);
  border-radius: 25px;
  margin-right: 3px;
  justify-content: center;
  align-items: center;
  border: 3px solid rgba(255,255,255,0.06); /* 添加边框 */
}

.settings-icon {
  width: 16px;
  height: 16px;
}

.note-list {
  align-items: center;
  flex: 1;
  width: 212px;
  padding-top: 7px;
}

.note-item {
  height: 90px;
  width: 202px;
  background-color: #262626;
  flex-direction: column;
  justify-content: center;
  border-radius: 20px; /* 添加圆角 */
  margin-left: 5px; /* 添加外边距 */
  margin-bottom: 7px;
  padding:5px;
}

.note-text {
  flex: 1;
  font-size: 24px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
  padding:2px;
}

.recovery-note {
  color: #4a9eff;
}

.note-time {
  font-size: 18px;
  color: #999999;
  margin-top: 5px;
}

.recovery-note-time {
  color: #4a9eff;
}

.empty-tip {
  position: absolute;
  top: 238px;
  left: 50px;
}
.empty-tip-text {
  font-size: 28px;
  color: #666666;
}

.add-btn-text {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}
.load-dialog {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  justify-content: center;
  align-items: center;
}

.load-content {
  width: 90%;
  background-color: #1f1f1f;
  border: 3px solid rgba(255,255,255,0.06); /* 修改边框样式 */
  border-radius: 12px; /* 修改圆角 */
  padding: 20px;
  flex-direction: column;
}

.load-title {
  font-size: 28px;
  color: #ffffff;
  text-align: center;
  margin-bottom: 10px;
}
.safe-area {
  height: 50px;
  background-color: #000000;
}

.conn-banner {
  width: 202px;
  height: 36px;
  background-color: #1f1f1f;
  justify-content: center;
  align-items: center;
  margin-top: 5px;
  margin-left: 5px;
  border: 3px solid rgba(255,255,255,0.06);
}

.conn-banner-text {
  font-size: 18px;
  color: #ffffff;
}

</style>