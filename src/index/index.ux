<template>
  <div class="page">
    <!-- 添加时间显示 -->
    <div class="time-display" onclick="scrollToTop">
      <text class="time-text">{{currentTime}}</text>
    </div>
    <div class="header">
      <text class="title">笔记</text>
      <div class="header-buttons">
        <div class="settings-btn" onclick="goToSettings">
          <image src="/Common/settings.png" class="settings-icon"></image>
        </div>
        <div class="add-btn" onclick="addNote">
          <text class="add-btn-text">+</text>
        </div>
      </div>
    </div>
    
    <list class="note-list" id="noteList" bounces="true">
      <list-item type="note" class="note-item" for="{{(index, note) in notes}}" onclick="editNote(index)">
        <text class="note-text {{note.recovery ? 'recovery-note' : ''}}">{{getPreview(note)}}</text>
        <text class="note-time {{note.recovery ? 'recovery-note-time' : ''}}">{{formatNoteTime(note)}}</text>
      </list-item>
      <list-item type="safe-area" class="safe-area">
      </list-item>
    </list>

    
    <div if="{{notes.length === 0}}" class="empty-tip">
      <text class="empty-tip-text">暂无笔记</text>
    </div>
  
    <!-- 加载提示对话框 -->
    <div class="load-dialog" if="{{showLoading}}">
      <div class="load-content">
        <text class="load-title" style="margin-bottom:0px">加载中</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCachedSettings, addSettingsListener, removeSettingsListener, addNotesListener, removeNotesListener } from '../Common/utils.js'

export default {
  private: {
    notes: [],
    loading: false,
    showLoading: false,
    navigationTimer: null,
    timeDisplayType: 'createTime', // 从设置中读取
    timeUpdateTimer: null,
    currentTime: '', // 添加当前时间变量
    lastSettingsLoad: 0, // 上次加载设置的时间
    settingsCache: null, // 设置缓存
    notesCache: null, // 笔记缓存
    lastNotesLoad: 0, // 上次加载笔记的时间
    notesCacheDuration: 5000 // 笔记缓存5秒
  },
  
  onInit() {
    this.loadSettings()
    this.loadNotes()
    // 初始化当前时间
    this.updateCurrentTime()
    // 启动时间更新定时器
    this.updateTimeDisplay()
    // 添加设置变化监听器
    addSettingsListener(this.onSettingsChange.bind(this));
    // 添加笔记变化监听器
    addNotesListener(this.onNotesChange.bind(this));
  },
  
  onShow() {
    // 每次页面显示时都重新加载设置和笔记列表
    // 清除设置缓存以确保获取最新设置
    this.settingsCache = null;
    this.lastSettingsLoad = 0;
    // 清除笔记缓存以确保获取最新笔记
    this.notesCache = null;
    this.lastNotesLoad = 0;

    this.loadSettings(true)
    this.loadNotes()
    // 确保隐藏加载对话框（特别是从edit页面返回时）
    this.showLoading = false;

    // 清除可能存在的跳转定时器
    if (this.navigationTimer) {
      clearTimeout(this.navigationTimer);
      this.navigationTimer = null;
    }

    // 更新当前时间
    this.updateCurrentTime()
    // 清除可能存在的旧时间更新定时器并启动新的定时器
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
    // 启动时间更新定时器
    this.updateTimeDisplay()
  },
  
  // 清除恢复文件
  clearRecoveryFile() {
    try {
      import('../Common/utils.js').then(utils => {
        utils.clearRecoveryFile((err) => {
          if (err) {
            console.error("清除恢复文件失败:", err);
          } else {
            console.log("恢复文件 recovery.txt 清除成功");
          }
        });
      });
    } catch (error) {
      console.error('清除恢复文件时发生异常:', error);
    }
  },
  
  onHide() {
    // 页面隐藏时清除定时器
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
  },
  
  onDestroy() {
    // 页面销毁时清除定时器
    if (this.timeUpdateTimer) {
      clearInterval(this.timeUpdateTimer)
      this.timeUpdateTimer = null
    }
    // 移除设置变化监听器
    removeSettingsListener(this.onSettingsChange.bind(this));
    // 移除笔记变化监听器
    removeNotesListener(this.onNotesChange.bind(this));
  },
  
  // 设置变化回调
  onSettingsChange(settings) {
    console.log('设置已更改:', settings);
    if (settings && settings.timeDisplayType !== this.timeDisplayType) {
      this.timeDisplayType = settings.timeDisplayType || 'createTime';
      // 重新排序笔记
      this.sortNotes();
    }
  },
  
  // 笔记变化回调
  onNotesChange() {
    console.log('笔记已更改，重新加载笔记列表');
    // 清除笔记缓存并重新加载
    this.notesCache = null;
    this.lastNotesLoad = 0;
    this.loadNotes();
  },
  
  loadSettings(forceReload = false) {
    // 检查是否需要重新加载设置（限制频率）
    const now = Date.now();
    if (!forceReload && this.settingsCache && (now - this.lastSettingsLoad) < 5000) {
      // 使用缓存的设置
      this.applySettings(this.settingsCache);
      return;
    }
    
    getCachedSettings((err, settings) => {
      this.settingsCache = settings;
      this.lastSettingsLoad = now;
      this.applySettings(settings);
    });
  },
  
  // 应用设置
  applySettings(settings) {
    const oldTimeDisplayType = this.timeDisplayType;
    if (settings) {
      this.timeDisplayType = settings.timeDisplayType || 'createTime';
    } else {
      this.timeDisplayType = 'createTime';
    }
    
    // 如果排序方式改变，重新排序
    if (oldTimeDisplayType !== this.timeDisplayType) {
      this.sortNotes();
    }
  },
  
  loadNotes() {
    const now = Date.now();
    // 检查笔记缓存
    if (this.notesCache && (now - this.lastNotesLoad) < this.notesCacheDuration) {
      this.notes = this.notesCache;
      this.loading = false;
      return;
    }

    // 显示加载提示
    this.loading = true;

    import('../Common/utils.js').then(utils => {
      utils.readMetadata((err, metadata) => {
        if (err) {
          console.log("读取元数据失败:", err);
          this.notes = [];
          this.notesCache = [];
          this.lastNotesLoad = now;
          this.loading = false;
          return;
        }

        // 获取所有笔记（排除恢复笔记标记）
        const noteEntries = Object.entries(metadata.notes || {})
          .filter(([noteData]) => !noteData.recovery) // 过滤掉旧的恢复标记
          .map(([noteId, noteData]) => ({
            id: noteId,
            createTime: noteData.createTime,
            modifyTime: noteData.modifyTime,
            recovery: false
          }));

        // 按时间排序
        noteEntries.sort((a, b) => b.createTime - a.createTime);

        // 逐个读取笔记内容
        let loadedNotes = [];
        let loadedCount = 0;
        const totalCount = noteEntries.length;

        // 先检查 recovery.txt 是否有内容
        utils.readRecoveryFile((recoveryErr, recoveryContent) => {
          let hasRecovery = false;
          if (!recoveryErr && recoveryContent && recoveryContent.trim() !== '') {
            hasRecovery = true;
          }

          // 如果没有正常笔记，只有恢复文件
          if (totalCount === 0 && !hasRecovery) {
            this.notes = [];
            this.notesCache = [];
            this.lastNotesLoad = now;
            this.loading = false;
            return;
          }

          // 如果有恢复文件，添加到笔记列表开头
          if (hasRecovery) {
            const recoveryTimestamp = now; // 使用当前时间作为恢复笔记的时间
            loadedNotes.push({
              content: recoveryContent,
              originalIndex: -1,
              id: 'recovery',
              createTime: recoveryTimestamp,
              modifyTime: recoveryTimestamp,
              recovery: true
            });
          }

          // 如果没有任何正常笔记，只有恢复文件
          if (totalCount === 0) {
            this.notes = loadedNotes.filter(note => note !== undefined);
            this.notesCache = this.notes;
            this.lastNotesLoad = now;
            this.loading = false;
            return;
          }

          noteEntries.forEach((noteEntry, index) => {
            utils.readNoteFile(noteEntry.id, (err, content) => {
              loadedCount++;

              // 调整索引，因为前面可能插入了恢复笔记
              const actualIndex = index + (hasRecovery ? 1 : 0);

              if (!err && content !== undefined) {
                loadedNotes[actualIndex] = {
                  content: `${content}`,
                  originalIndex: index,
                  id: noteEntry.id,
                  createTime: noteEntry.createTime,
                  modifyTime: noteEntry.modifyTime,
                  recovery: false
                };
              } else {
                console.error(`读取笔记 ${noteEntry.id} 失败:`, err);
                loadedNotes[actualIndex] = {
                  content: ``,
                  originalIndex: index,
                  id: noteEntry.id,
                  createTime: noteEntry.createTime,
                  modifyTime: noteEntry.modifyTime,
                  recovery: false
                };
              }

              // 检查是否所有笔记都已加载完成
              if (loadedCount === totalCount) {
                // 过滤掉加载失败的笔记
                this.notes = loadedNotes.filter(note => note !== undefined);
                this.notesCache = this.notes;
                this.lastNotesLoad = now;
                this.loading = false;
              }
            });
          });
        });
      });
    }).catch(err => {
      console.error("导入工具模块失败:", err);
      this.notes = [];
      this.notesCache = [];
      this.lastNotesLoad = now;
      this.loading = false;
    });
  },

  getPreview(text) {
    // 返回文本的前32个字符
    if (!text) return '';
    // 提取笔记主体内容（去除时间戳部分）
    const parts = text.content.split('|');
    const content = parts[0] || '';
    if (content.length <= 32) return content;
    return content.substring(0, 32);
  },

  // 格式化笔记时间显示
  formatNoteTime(note) {
    // 如果是恢复的笔记，返回特殊标记
    if (note.recovery) {
      return '恢复的笔记';
    }

    // 时间类型
    const timeType = this.timeDisplayType === 'createTime' ? '创建' : '修改';

    // 使用笔记对象中的时间属性
    const createTime = note.createTime;
    const modifyTime = note.modifyTime;
    if (!createTime || !modifyTime) return '没有记录'+ timeType + '时间'; // 如果没有时间信息



    // 根据当前显示类型选择时间
    const time = this.timeDisplayType === 'createTime' ? createTime : modifyTime;

    // 格式化时间显示为 YYMMDD HHMM
    const date = new Date(time);
    const year = (date.getFullYear() % 100).toString().padStart(2, '0');
    const month = (date.getMonth() + 1).toString().padStart(2, '0');
    const day = date.getDate().toString().padStart(2, '0');
    const hour = date.getHours().toString().padStart(2, '0');
    const minute = date.getMinutes().toString().padStart(2, '0');

    return `${year}.${month}.${day} ${hour}:${minute} ${timeType}`;
  },
  
  // 格式化当前时间显示（HH:MM格式）
  updateCurrentTime() {
    const now = new Date();
    const hour = now.getHours().toString().padStart(2, '0');
    const minute = now.getMinutes().toString().padStart(2, '0');
    this.currentTime = `${hour}:${minute}`;
  },
  
  // 更新时间显示
  updateTimeDisplay() {
    this.timeUpdateTimer = setInterval(() => {
      // 更新当前时间
      this.updateCurrentTime();
    }, 10000); 
  },
  
  // 切换时间显示类型
  toggleTimeDisplay() {
    this.timeDisplayType = this.timeDisplayType === 'createTime' ? 'modifyTime' : 'createTime';
    this.sortNotes();
  },
  
  // 按时间排序笔记
  sortNotes() {
    this.notes.sort((a, b) => {
      const partsA = a.content.split('|');
      const partsB = b.content.split('|');
      
      if (partsA.length < 3 || partsB.length < 3) return 0;
      
      const timeA = this.timeDisplayType === 'createTime' 
        ? parseInt(partsA[1]) 
        : parseInt(partsA[2]);
        
      const timeB = this.timeDisplayType === 'createTime' 
        ? parseInt(partsB[1]) 
        : parseInt(partsB[2]);
      
      // 从新到旧排序
      return timeB - timeA;
    });
  },
  
  addNote() {
    // 显示加载提示
    this.showLoading = true;
    
    // 使用setTimeout确保UI更新后才执行跳转，并保存定时器ID以便取消
    this.navigationTimer = setTimeout(() => {
      router.push({
        uri: '/edit',
        params: {
          index: -1,
          content: ''
        }
      })
    }, 100);
  },
  
  editNote(index) {
    // 显示加载提示
    this.showLoading = true;

    const note = this.notes[index];
    
    // 如果是恢复的笔记
    if (note.recovery) {
      // 跳转到编辑页面，传递恢复的内容和标记
      this.navigationTimer = setTimeout(() => {
        router.push({
          uri: '/edit',
          params: {
            index: -1,
            content: note.content,
            fromRecovery: true
          }
        });
      }, 100);
      return;
    }

    // 使用setTimeout确保UI更新后才执行跳转，并保存定时器ID以便取消
    this.navigationTimer = setTimeout(() => {
      router.push({
        uri: '/edit',
        params: {
          index: note.originalIndex, // 传递原始索引
          content: note.content
        }
      })
    }, 100);
  },
  
  
  // 跳转到设置页面
  goToSettings() {
    router.push({
      uri: '/settings'
    });
  },
  scrollToTop() {
    const scrollElement = this.$element("noteList")
    scrollElement.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
          console.log('滚动执行成功');
  }
}
</script>

<style>
.page {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
  overflow-x: hidden;
}

.time-display {
  height: 24px;
  justify-content: center;
  align-items: center;
  border-radius: 12px; /* 添加圆角 */
  margin: 5px;
  padding: 5px;
}

.time-text {
  font-size: 20px;
  font-weight: bold;
  color: #999999;
}

.header {
  height: 60px;
  padding-left: 20px;
  padding-right: 20px;
  border-bottom-width: 2px;
  border-bottom-color: #333333;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 30px;
  color: #ffffff;
}

.header-buttons {
  flex-direction: row;
  align-items: center;
}

.settings-btn,.add-btn {
  width: 50px;
  height: 50px;
  background-color: rgb(38,38,38);
  border-radius: 25px;
  margin-right: 3px;
  justify-content: center;
  align-items: center;
  border: 3px solid rgba(255,255,255,0.06); /* 添加边框 */
}

.settings-icon {
  width: 16px;
  height: 16px;
}

.note-list {
  align-items: center;
  flex: 1;
  width: 212px;
  padding-top: 7px;
}

.note-item {
  height: 90px;
  width: 202px;
  background-color: #262626;
  flex-direction: column;
  justify-content: center;
  border-radius: 20px; /* 添加圆角 */
  margin-left: 5px; /* 添加外边距 */
  margin-bottom: 7px;
  padding:5px;
}

.note-text {
  flex: 1;
  font-size: 24px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
  padding:2px;
}

.recovery-note {
  color: #4a9eff;
}

.note-time {
  font-size: 18px;
  color: #999999;
  margin-top: 5px;
}

.recovery-note-time {
  color: #4a9eff;
}

.empty-tip {
  position: absolute;
  top: 238px;
  left: 50px;
}
.empty-tip-text {
  font-size: 28px;
  color: #666666;
}

.add-btn-text {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}
.load-dialog {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  justify-content: center;
  align-items: center;
}

.load-content {
  width: 90%;
  background-color: #1f1f1f;
  border: 3px solid rgba(255,255,255,0.06); /* 修改边框样式 */
  border-radius: 12px; /* 修改圆角 */
  padding: 20px;
  flex-direction: column;
}

.load-title {
  font-size: 28px;
  color: #ffffff;
  text-align: center;
  margin-bottom: 10px;
}
.safe-area {
  height: 50px;
  background-color: #000000;
}
</style>