<import name="input-method" src="../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <!-- 时间显示 -->
    <div style="height: 24px; justify-content: center;align-items: center;border-radius: 12px; margin: 5px; padding: 5px;" onclick="scrollToTop">
      <text style="font-size: 20px; font-weight: bold; color: #999999;">{{currentTime}}</text>
    </div>
    
    <!-- 顶部导航栏 -->
    <div style="height: 60px; padding-left: 20px; padding-right: 20px; border-bottom-width: 2px ;border-bottom-color: #333333; align-items: center; justify-content: space-between;">
      <input type="button" class="header-btn" value="<" onclick="back"/>
        <input type="button" class="header-btn" value="···" onclick="showMenu"/>
    </div>
    
    <!-- 主内容区域 -->
    <div style="flex: 1; flex-direction: column;">
      <!-- 显示区域 -->
      <scroll id="textScroll"
        style="width: 100%; flex: 1; min-height: 103px; flex-direction: column; overflow: auto; padding: {{borderWidth}};"
        scroll-y="true"
        scroll-top="{{scrollTopValue}}"
        @scroll="onScroll"
        @scrolltop="onScrollTop"
        @scrollbottom="onScrollBottom"
        @touchstart="onTouchStart"
        bounces="true"
        @touchmove="onTouchMove"
        @touchend="onTouchEnd">

          <!-- 文本内容显示区域：只渲染滚动位置处的 3 个分段（游标可不在其中） -->
          <div style="flex-direction: column;">
            <div id="chunkWrap0" style="flex-direction: column;">
              <text style="width: 100%; text-align: left; color: #ffffff; font-size: 26px; line-height: 34px">{{blk0Before}}<span if="{{blk0Cursor}}" id="caret" class="cursor" style="width: 2px; height: 34px; vertical-align: text-bottom; color:#888888;">|</span><span if="{{blk0Cursor}}">{{blk0After}}</span></text>
            </div>
            <div if="{{winEnd - winStart >= 1}}" id="chunkWrap1" style="flex-direction: column;">
              <text style="width: 100%; text-align: left; color: #ffffff; font-size: 26px; line-height: 34px">{{blk1Before}}<span if="{{blk1Cursor}}" id="caret" class="cursor" style="width: 2px; height: 34px; vertical-align: text-bottom; color:#888888;">|</span><span if="{{blk1Cursor}}">{{blk1After}}</span></text>
            </div>
            <div if="{{winEnd - winStart >= 2}}" id="chunkWrap2" style="flex-direction: column;">
              <text style="width: 100%; text-align: left; color: #ffffff; font-size: 26px; line-height: 34px">{{blk2Before}}<span if="{{blk2Cursor}}" id="caret" class="cursor" style="width: 2px; height: 34px; vertical-align: text-bottom; color:#888888;">|</span><span if="{{blk2Cursor}}">{{blk2After}}</span></text>
            </div>
            <div style="height: 34px;" if="{{autoScrollType === 'oneBlank'}}"></div>
            <div style="height: 68px;" if="{{autoScrollType === 'twoBlank'}}"></div>
            <div style="height: 100px;" if="hideInput"></div>
          </div>
      </scroll>
      
      <!-- 输入法区域 -->
      <div style="width: 100%; height: 307px; background-color: #333333; position: relative; z-index: 10;" if="!hideInput"></div>
        <input-method
          id="inputMethod"
          hide="{{hideInput}}"
          vibratemode="{{vibrateMode}}"
          @delete="onDelete"
          @complete="onInputComplete"
        ></input-method>
      </div>
    
    <!-- 菜单对话框 -->
    <div class="dialog-overlay" if="showMenuDialog">
      <div class="dialog" style="width: 85%;">
        <text class="dialog-title">操作选项</text>
        <div style="flex-direction: column;">
          <input type="button" class="dialog-option" value="保存" onclick="saveNote"/>
          <input type="button" class="dialog-option" value="生成二维码" onclick="showQRCode"/>
          <input type="button" class="dialog-option" value="删除" onclick="deleteNote" if="isEdit" style="background-color: #ff0000;"/>
          <input type="button" class="dialog-option" value="取消" onclick="cancelMenu" style="background-color: #666666;"/>
        </div>
      </div>
    </div>
    
    <!-- 删除确认对话框 -->
    <div class="dialog-overlay" if="showConfirmDialog">
      <div class="dialog" style="width: 90%;">
        <text class="dialog-title">确认删除</text>
        <text class="dialog-message">确定要删除这条笔记吗？</text>
        <div class="dialog-buttons">
          <input type="button" class="dialog-button" value="否" onclick="cancelDelete" style="height: 80px;"/>
          <input type="button" class="dialog-button" value="是" onclick="confirmDelete" style="background-color: #ff0000; height: 60px; margin-bottom: 0;"/>
        </div>
      </div>
    </div>
    
    <!-- 二维码对话框 -->
    <div class="dialog-overlay" if="showQRDialog">
      <div class="dialog" style="width: 95%; padding: 6px; align-items: center;">
        <text class="dialog-title">笔记内容二维码</text>
        <qrcode style="width: 180px; height: 180px; margin: 10px 0;" value="{{noteContentForQR}}" />
        <input type="button" class="dialog-button" value="确定" onclick="closeQRDialog"/>
      </div>
    </div>
    
    <!-- 退出确认对话框 -->
    <div class="dialog-overlay" if="showExitConfirm">
      <div class="dialog" style="width: 90%;">
        <text class="dialog-title">确认退出</text>
        <text class="dialog-message">笔记尚未保存，确定要退出吗？</text>
        <div class="dialog-buttons">
          <input type="button" class="dialog-button" value="取消" onclick="cancelExit" style="height: 80px;"/>
          <input type="button" class="dialog-button" value="确定" onclick="confirmExit" style="background-color: #ff0000; height: 60px; margin-bottom: 0;"/>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  background-color: #000000;
  width: 100%;
  height: 100%;
}
.header-btn {
  width: 80px;
  height: 50px;
  margin-left: 5px;
  margin-right: 5px;
  background-color: rgb(38,38,38);
  color: #ffffff;
  font-size: 24px;
  border-radius: 12px; /* 添加圆角 */
  border: 3px solid rgba(255,255,255,0.06); /* 添加边框 */
}
.dialog-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  justify-content: center;
  align-items: center;
  border:3px solid rgba(255,255,255,0.06);
}

.dialog {
  background-color: #1f1f1f;
  border: 3px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  padding: 20px;
  flex-direction: column;
}

.dialog-title {
  font-size: 28px;
  color: #ffffff;
  text-align: center;
  margin-bottom: 20px;
}

.dialog-option {
  width: 100%;
  height: 50px;
  font-size: 24px;
  border-radius: 12px;
  background-color: #262626;
  border: 3px solid rgba(255,255,255,0.06);
  color: #ffffff;
  margin-bottom: 10px;
  text-align: center;
}

.dialog-message {
  font-size: 24px;
  color: #ffffff;
  text-align: center;
  margin-bottom: 20px;
}

.dialog-buttons {
  flex-direction: column;
  justify-content: space-around;
  color: #ffffff
}

.dialog-button {
  width: 100%;
  font-size: 24px;
  border-radius: 12px;
  background-color: #262626;
  border: 3px solid rgba(255,255,255,0.06);
  color:#ffffff;
  margin-bottom: 10px;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import vibrator from '@system.vibrator'
import {notifyNotesChange, getCachedSettings } from '../Common/utils.js'
import { createDocFromText, loadDocFromFile, getRange, insertText, deleteRange, locate, materialize, writeChunks } from '../Common/textSegments.js'

// 调试用：单段字节长度（正式值为 512，调小便于观察分段/翻段行为）
const SEG_BYTES = 128

export default {
  // 非响应式实例属性：分段文档、滚动节流标记
  __doc: null,
  __scrollScheduled: false,

  private: {
    // 基础属性
    index: -1,
    content: '',
    noteId: '',
    isEdit: false,
    hideInput: false,
    isSaved: true,
    isSaving: false,
    vibrateMode: 'short',
    currentTime: "",
    borderWidth: '10px', // 默认边框宽度
    fromRecovery: false, // 是否从恢复文件进入

    // 分段窗口渲染（最多 3 段）
    winStart: 0,
    winEnd: 0,
    blk0Before: '', blk0After: '', blk0Cursor: false,
    blk1Before: '', blk1After: '', blk1Cursor: false,
    blk2Before: '', blk2After: '', blk2Cursor: false,

    // 滚动状态
    scrollTopValue: 0,
    currentScrollTop: 0,
    scrollWait: false,

    // 对话框控制
    showMenuDialog: false,
    showConfirmDialog: false,
    showQRDialog: false,
    showExitConfirm: false,

    // 主定时器
    mainTimer: null,
    // 定时器计数器
    timeUpdateCounter: 0,   // 用于每10秒更新时间

    // 操作计数器（用于恢复文件）
    operationCounter: 0,
    maxOperationsBeforeRecovery: 5,

    // 二维码内容
    noteContentForQR: '',

    // 自动滚动设置
    autoScrollType: 'oneBlank', // 默认为留空1行


    // 光标位置相关
    cursorPosition: 0, // 光标位置，默认在末尾

    // 触摸事件相关
    touchStartX: 0,
    touchStartY: 0,
    touchStartTime: 0,
    lastTouchX: 0,
    lastTouchY: 0,
    isTouchMoving: false,
    maxMoveDistance: 0, // 记录最大移动距离
    touchStartPosition: 0, // 记录触摸开始时光标的位置
    lastMoveTime: 0, // 记录上次移动的时间
    lastDeltaX: 0, // 记录上次的水平位移

    // 恢复文件脏标记（避免每 10s 反复写整篇）
    _recoveryDirty: false,
    _recoveryWriting: false,

    // 用于保存原始笔记ID，确保编辑时始终指向正确的笔记
    originalNoteId: null,
  },

  onInit() {
    try {
      // 加载设置
      this.loadSettings();

      // 设置创建时间为打开页面的时间
      this.createTime = Date.now();

      // 设置编辑状态
      if (this.index >= 0) {
        this.isEdit = true;
      }

      // 默认显示输入法
      this.hideInput = false;

      // 启动主定时器
      this.startMainTimer();

      // 初始化分段文档（既有笔记会异步从磁盘按字节分段读取）
      this.initDoc();
    } catch (e) {
      console.error('初始化页面时出错:', e);
      this.__doc = createDocFromText('', SEG_BYTES);
      this.hideInput = false;
    }
  },

  // ===== 分段文档 =====
  initDoc() {
    // 恢复笔记：直接使用传入的全文
    if (this.fromRecovery) {
      this.__doc = createDocFromText(this.content || '', SEG_BYTES);
      this.afterDocReady();
      return;
    }
    // 编辑既有笔记：从磁盘按字节分段读取
    if (this.noteId) {
      loadDocFromFile(`internal://files/note_${this.noteId}.txt`, SEG_BYTES, (err, doc) => {
        if (err || !doc) {
          this.__doc = createDocFromText(this.content || '', SEG_BYTES);
        } else {
          this.__doc = doc;
        }
        this.afterDocReady();
      });
      return;
    }
    // 新笔记
    this.__doc = createDocFromText(this.content || '', SEG_BYTES);
    this.afterDocReady();
  },

  afterDocReady() {
    // 光标初始在末尾
    this.cursorPosition = this.textLength();
    this.buildWindow();
    this.refreshSlices();
    // 从恢复文件进入：先落盘一次
    if (this.fromRecovery && this.textLength() > 0 && this.fullText().trim() !== '') {
      this.saveToFile();
    }
    this.$nextTick(() => {
      setTimeout(() => this.scrollToBottom(), 60);
    });
    console.log("编辑器初始化完成, 段数:", this.__doc ? this.__doc.chunks.length : 0);
  },

  textLength() {
    return this.__doc ? this.__doc.charCount : 0;
  },

  fullText() {
    return materialize(this.__doc);
  },

  // 计算渲染窗口（最多 3 段）。anchorIndex 为窗口锚点分段，默认取游标段；
  // 窗口一旦确定就只随滚动平移，不再跟随游标。
  buildWindow(anchorIndex) {
    const doc = this.__doc;
    if (!doc) return;
    const n = doc.chunks.length;
    let anchor = typeof anchorIndex === 'number' ? anchorIndex : locate(doc, this.cursorPosition).index;
    if (anchor < 0) anchor = 0;
    if (anchor > n - 1) anchor = n - 1;
    let ws = anchor - 1;
    if (ws < 0) ws = 0;
    let we = ws + 2;
    if (we > n - 1) {
      we = n - 1;
      ws = Math.max(0, we - 2);
    }
    this.winStart = ws;
    this.winEnd = we;
  },

  // 生成 3 个分段的渲染数据（含游标所在段的 before/after）
  refreshSlices() {
    const doc = this.__doc;
    if (!doc) {
      this.setBlocks('', false, '', '', false, '', '', false, '');
      return;
    }
    // 删除可能合并分段使窗口越界，这里做一次收敛
    const n = doc.chunks.length;
    if (this.winStart > n - 1) this.winStart = Math.max(0, n - 1);
    if (this.winEnd > n - 1) this.winEnd = n - 1;
    if (this.winEnd < this.winStart) this.winEnd = this.winStart;
    const starts = doc.starts;
    let cursorSlot = -1;
    const loc = locate(doc, this.cursorPosition);
    if (loc.index >= this.winStart && loc.index <= this.winEnd) {
      cursorSlot = loc.index - this.winStart;
    }
    const slots = [];
    for (let j = 0; j < 3; j++) {
      const ci = this.winStart + j;
      if (ci > this.winEnd) {
        slots.push({ before: '', after: '', cursor: false });
        continue;
      }
      const cStart = starts[ci];
      const cEnd = starts[ci + 1];
      if (j === cursorSlot) {
        slots.push({
          before: this.normalize(getRange(doc, cStart, this.cursorPosition)),
          after: this.normalize(getRange(doc, this.cursorPosition, cEnd)),
          cursor: true,
        });
      } else {
        slots.push({ before: this.normalize(getRange(doc, cStart, cEnd)), after: '', cursor: false });
      }
    }
    this.setBlocks(
      slots[0].before, slots[0].cursor, slots[0].after,
      slots[1].before, slots[1].cursor, slots[1].after,
      slots[2].before, slots[2].cursor, slots[2].after
    );
  },

  setBlocks(b0, c0, a0, b1, c1, a1, b2, c2, a2) {
    this.blk0Before = b0; this.blk0Cursor = c0; this.blk0After = a0;
    this.blk1Before = b1; this.blk1Cursor = c1; this.blk1After = a1;
    this.blk2Before = b2; this.blk2Cursor = c2; this.blk2After = a2;
  },

  // 每个换行后补零宽空格，保证空行也能看到光标
  normalize(text) {
    if (!text) return '';
    return text.replace(/\n/g, '\n\u200B');
  },

  // 光标是否位于当前渲染窗口内
  isCursorInWindow() {
    const doc = this.__doc;
    if (!doc) return false;
    const loc = locate(doc, this.cursorPosition);
    return loc.index >= this.winStart && loc.index <= this.winEnd;
  },

  // 光标移动/编辑后刷新窗口切片。
  // followCursor 仅在“编辑前游标可见、编辑后因分段增删被挤出窗口”时为 true，
  // 此时才把窗口锚回游标；其余情况（用户滚动、滑动游标）窗口保持不变，不拉回。
  onCursorMoved(followCursor) {
    if (followCursor && !this.isCursorInWindow()) {
      this.buildWindow();
    }
    this.refreshSlices();
  },

  // 加载设置
  loadSettings() {
    getCachedSettings((err, settings) => {
      if (!err && settings) {
        this.vibrateMode = settings.vibrationEnabled !== false ? 'short' : '';
        this.borderWidth = settings.borderWidth || '10px';
        this.autoScrollType = settings.autoScrollType || 'oneBlank';
      }
    });
  },
  
  onReady() {
    //星方：try-catch无意义使用(已修复)
    // 先更新时间
    this.updateCurrentTime();
    console.log("页面准备完成");
    // 确保文本内容渲染完成
    this.$nextTick(() => {
      // 延迟执行滚动到底部操作，确保文本渲染完成
      setTimeout(() => {
        try {
          this.scrollToBottom();
        } catch (e) {
          console.warn('页面加载后滚动到底部失败:', e);
          console.error('onReady方法出错');
        }
      }, 100);
    });
  },
  
  onShow() {
    //星方：无意义的try-catch（你希望捕捉什么）
    // 更新当前时间
    this.updateCurrentTime();
    
    // 优先使用路由传入的 noteId；否则退回按索引解析
    if (this.noteId) {
      this.originalNoteId = this.noteId;
    } else if (this.index >= 0 && !this.originalNoteId) {
      this.getOriginalNoteId();
    }
  },

  // 获取原始笔记ID
  getOriginalNoteId() {
    import('../Common/utils.js').then(utils => {
      utils.readMetadata((err, metadata) => {
        if (err) {
          console.error("读取元数据失败:", err);
          return;
        }
        
        // 获取当前笔记的ID
        const noteIds = Object.keys(metadata.notes || {}).sort((a, b) => {
          return metadata.notes[b].createTime - metadata.notes[a].createTime;
        });
        
        if (this.index >= noteIds.length) {
          console.error("笔记索引超出范围");
          return;
        }
        
        // 记录原始笔记ID，确保后续保存始终使用这个ID
        this.originalNoteId = noteIds[this.index];
        console.log("记录原始笔记ID:", this.originalNoteId);
      });
    });
  },
  
  onHide() {
    // 清除定时器
    this.clearAllTimers();
  },
  
  onDestroy() {
    // 清除所有定时器
    this.clearAllTimers();
    
    // 页面销毁时清除恢复文件
    this.clearRecoveryFile();
  },
  
  // 清除所有定时器
  clearAllTimers() {
    if (this.mainTimer) {
      clearInterval(this.mainTimer);
      this.mainTimer = null;
    }
  },
  

  // 启动主定时器（10s间隔）
  startMainTimer() {
    // 清除已存在的主定时器
    if (this.mainTimer) {
      clearInterval(this.mainTimer);
      this.mainTimer = null;
    }
    
    // 初始化计数器
    this.operationCounter = 0;
    
    // 启动主定时器，每10s执行一次
    this.mainTimer = setInterval(() => {        
        this.updateCurrentTime();
        this.checkAndSaveRecovery();
      }, 10000);
  },
  
  // 增加操作计数器并在达到阈值时保存恢复文件
  //星方：可以将这个修改为定时器逻辑，防抖
  incrementOperationCounter() {
    this.operationCounter++;
    if (this.operationCounter >= this.maxOperationsBeforeRecovery) {
      this.checkAndSaveRecovery();
      this.operationCounter = 0;
    }
  },
  
  // 更新当前时间
  updateCurrentTime() {
    const now = new Date();
    const hour = now.getHours().toString().padStart(2, '0');
    const minute = now.getMinutes().toString().padStart(2, '0');
    this.currentTime = `${hour}:${minute}`;
  },
  
  // 统一处理输入法状态更新
  updateInputState(isVisible) {
    this.hideInput = !isVisible;
  },
  
  // 切换输入法显示状态
  toggleInputMethod() {
    try {
      if (this.vibrateMode) {
        try {
          vibrator.vibrate({
            mode: this.vibrateMode
          });
        } catch (e) {
          console.warn('振动功能调用失败:', e);
        }
      }
      
      // 使用统一的函数替代直接赋值
      this.updateInputState(this.hideInput);
            
    } catch (e) {
      console.error('切换输入法显示状态时出错:', e);
    }
    console.log('切换输入法显示状态成功');
  },
  
  // 移动光标
  moveCursor(direction) {
    if (direction === 'left' && this.cursorPosition > 0) {
      this.cursorPosition--;
      if (this.vibrateMode) {
        vibrator.vibrate({ mode: this.vibrateMode });
      }
    } else if (direction === 'right' && this.cursorPosition < this.textLength()) {
      this.cursorPosition++;
      if (this.vibrateMode) {
        vibrator.vibrate({ mode: this.vibrateMode });
      }
    }
  },
  
  // 触摸开始事件
  onTouchStart(event) {
    if (event.touches && event.touches.length > 0) {
      this.touchStartX = event.touches[0].clientX;
      this.lastTouchX = this.touchStartX;
      this.touchStartTime = Date.now();
      this.isTouchMoving = false;
      // 记录触摸开始时光标的位置
      this.touchStartPosition = this.cursorPosition;
      // 初始化速度相关变量
      this.lastMoveTime = Date.now();
      this.lastDeltaX = 0;
    }
  },
  
  // 触摸移动事件
  onTouchMove(event) {
    if (event.touches && event.touches.length > 0 && this.textLength() > 0) {
      const currentX = event.touches[0].clientX;
      const currentTime = Date.now();
      const deltaTime = currentTime - this.lastMoveTime;
      
      // 计算瞬时移动距离和速度
      const deltaX = currentX - this.lastTouchX;
      const absDeltaX = Math.abs(deltaX);
      
      // 设置基础移动阈值
      const baseThreshold = 20;
      
      // 根据移动速度动态调整阈值，速度快时降低阈值以提高灵敏度
      let moveThreshold = baseThreshold;
      if (deltaTime > 0 && deltaTime < 100) { // 限制时间间隔，避免异常值
        // 计算速度（像素/毫秒）
        const velocity = absDeltaX / deltaTime;
        
        // 根据速度动态调整阈值，速度越快阈值越小，响应越灵敏
        // 同时实现平方增长效果 - 速度越快，光标移动步长越大
        if (velocity > 0.5) {
          const speedFactor = Math.min(5, Math.pow(velocity * 2, 2)); // 平方增长因子，最大5倍
          moveThreshold = Math.max(5, baseThreshold / speedFactor); // 最小阈值为5
        }
      }

      const currentY = event.touches[0].clientY;
      const deltaY = currentY - this.lastTouchY;
      const moveThresholdY = 20;

      // 判断是否是左右滑动
      if (absDeltaX >= moveThreshold) {
        this.isTouchMoving = true;
        
        // 根据移动速度决定光标移动步长
        let moveSteps = 1;
        if (deltaTime > 0 && deltaTime < 100) {
          const velocity = absDeltaX / deltaTime;
          // 光标移动步长与速度的1.5次方成正比
          moveSteps = Math.min(5, Math.floor(Math.pow(velocity * 5, 1.5))); // 最大步长为5
        }
        
        if (deltaX < 0) {
          // 向左滑动，光标向左移动
          for (let i = 0; i < moveSteps; i++) {
            this.moveCursor('left');
          }
        } else if (deltaX > 0) {
          // 向右滑动，光标向右移动
          for (let i = 0; i < moveSteps; i++) {
            this.moveCursor('right');
          }
        }
        
        this.lastTouchX = currentX;
        this.lastMoveTime = currentTime;
        this.lastDeltaX = deltaX;
        // 光标移动后刷新分段窗口与游标前后文本（滑动游标不拉回窗口）
        this.onCursorMoved(false);
      }

      if (Math.abs(deltaY) >= moveThresholdY) {
        this.isTouchMoving = true;
      }
    }
  },
  
  // 触摸结束事件
  onTouchEnd() {
    // 只有在没有发生光标移动时才切换键盘
    if (!this.isTouchMoving) {
      this.toggleInputMethod();
    }
    
    // 重置状态
    this.isTouchMoving = false;
    this.touchStartPosition = -1;
  },
  
  
  // 处理删除操作
  onDelete() {
    try {
      if (this.hideInput) return;
      
      // 记录删除前游标是否可见，仅此时才允许窗口跟随分段合并
      const cursorVisible = this.isCursorInWindow();

      // 删除光标前的字符
      if (this.cursorPosition > 0) {
        deleteRange(this.__doc, this.cursorPosition - 1, 1);
        this.cursorPosition--;
        this.isSaved = false;
        this._recoveryDirty = true;
      }

      this.onCursorMoved(cursorVisible);

      //自动滚动
      if (this.cursorPosition >= this.textLength() - 1) {
        this.$nextTick(() => this.scrollToBottom());
      }

      // 增加操作计数器
      this.incrementOperationCounter();
      
    } catch (e) {
      console.error('处理删除操作时出错:', e);
    }
  },
  
  // 处理输入事件
  onInputComplete(e) {
    try {
      // 检查event对象是否存在
      if (!e) {
        console.warn("输入完成事件对象为空");
        return;
      }
      
      // 获取实际的内容（e.detail.content）
      let content = e.detail.content;
      
      // 检查content是否有效，如果无效则不处理
      if (content !== undefined && content !== null && content !== '') {
        // 记录插入前游标是否可见，仅此时才允许窗口跟随分段拆分
        const cursorVisible = this.isCursorInWindow();

        // 在光标位置插入内容
        insertText(this.__doc, this.cursorPosition, content);
        this.cursorPosition += content.length;
        
        // 标记为未保存
        this.isSaved = false;
        this._recoveryDirty = true;
        
        // 增加操作计数器
        this.incrementOperationCounter();
        
        this.onCursorMoved(cursorVisible);

        // 输入字符后，光标在末尾时自动滚到底部
        if (this.cursorPosition >= this.textLength() - 1) {
          this.$nextTick(() => this.scrollToBottom());
        }
      } else {
        console.log("输入完成事件内容为空或未定义，忽略处理");
      }
    } catch (error) {
      console.error('处理输入完成时出错:', error);
    }
  },
  
  // 返回操作
  back() {
    // 检查笔记是否已保存或者内容为空
    if (this.isSaved || this.textLength() === 0 || this.fullText().trim() === '') {
      // 清除恢复文件完成后再返回，避免 index 读到残留恢复文件
      this.clearRecoveryFileThen(() => router.back());
    } else {
      // 如果未保存且有内容，则显示确认对话框
      this.showExitConfirm = true;
      this.updateInputState(false);;
    }
  },
  
  // 返回手势
  onBackPress() {
    return true; //与光标操作冲突，禁用这个手势
  },
  
  // 显示菜单
  showMenu() {
    this.showMenuDialog = true;
    this.updateInputState(false);
  },

  //星方：函数封装重复片段，你想改就用，我给你替换了一段作为模版
  updateMetadata(fx, callback) {
    const utils = this.noteUtils;
    utils.readMetadata((err, metadata) => {
      if (err) {
        console.error("读取元数据失败:", err);
        callback?.(err);
        return;
      }
      // 让调用者修改 metadata
      fx(metadata);
      // 保存回去
      utils.saveMetadata(metadata, (err) => {
        if (err) console.error("保存元数据失败:", err);
        callback?.(err);
      });
    });
  },
  
  // 保存笔记
  saveNote() {
    if (this.isSaving) {
      console.log("正在保存中，请稍后再试");
      return;
    }
    
    const content = this.fullText();
    
    if (!content || !content.trim()) {
      prompt.showToast({
        message: '内容不能为空'
      });
      return;
    }
    
    this.isSaving = true;
    try {
      this.saveToFile();
    } catch (error) {
      console.error("保存笔记时出错:", error);
      this.isSaving = false;
      prompt.showToast({
        message: '保存失败'
      });
    }
  },
  
  // 保存到文件的核心方法：逐段 append 写入，避免保存时拼出整串
  saveToFile() {
    import('../Common/utils.js').then(utils => {
      try {
        const modifyTime = Date.now();
        
        let noteId = this.noteId || this.originalNoteId;
        if (!noteId) {
          noteId = this.createTime.toString();
        }
        this.originalNoteId = noteId;
        this.noteId = noteId;
        
        const uri = `internal://files/note_${noteId}.txt`;
        if (this.__doc) this.__doc.uri = uri;
        
        writeChunks(uri, this.__doc ? this.__doc.chunks : [''], (err) => {
          if (err) {
            console.error("保存笔记文件失败:", err);
            this.isSaving = false;
            prompt.showToast({
              message: '保存失败'
            });
            return;
          }
          
          if (this.__doc) this.__doc.dirty = false;
          this._recoveryDirty = false;
          
          // 更新元数据中的时间
          utils.readMetadata((err, metadata) => {
            if (err || !metadata) {
              metadata = { notes: {} };
            }
            if (!metadata.notes) metadata.notes = {};
            
            if (!metadata.notes[noteId]) {
              metadata.notes[noteId] = {
                createTime: this.createTime,
                modifyTime: modifyTime
              };
            } else {
              metadata.notes[noteId].modifyTime = modifyTime;
            }
            
            utils.saveMetadata(metadata, (err) => {
              if (err) {
                console.error("保存元数据失败:", err);
                this.isSaving = false;
                prompt.showToast({
                  message: '保存失败'
                });
                return;
              }
              
              this.handleSaveSuccess();
            });
          });
        });
      } catch (error) {
        console.error("保存到文件时出错:", error);
        this.isSaving = false;
        prompt.showToast({
          message: '保存失败'
        });
      }
    });
  },

  
  // 处理保存成功的逻辑
  handleSaveSuccess() {
    try {
      console.log("保存文件成功");
      // 更新保存状态
      this.isSaved = true;
      // 设置为编辑模式，以便显示删除按钮
      this.isEdit = true;
      // 重置保存状态标志
      this.isSaving = false;
      // 显示保存成功提示
      prompt.showToast({
        message: '保存成功'
      });
      // 保存成功后关闭菜单
      this.showMenuDialog = false;
      // 恢复输入法显示状态
      this.updateInputState(true);
      
      // 保存成功后清除恢复文件，再通知 index 刷新，避免 index 读到残留恢复文件
      this.clearRecoveryFileThen(() => {
        notifyNotesChange();
      });
      
      //计算safe-area大小
      this.$nextTick(function () { 
        this.scrollToBottom()
      });
    } catch (innerError) {
      console.error("保存成功回调处理异常:", innerError);
    }
  },
  
  // 显示二维码
  showQRCode() {
    this.showMenuDialog = false;
    this.noteContentForQR = this.fullText();
    this.showQRDialog = true;
    this.updateInputState(false);
  },
  
  // 关闭二维码对话框
  closeQRDialog() {
    this.showQRDialog = false;
    this.updateInputState(true);
  },
  
  // 删除笔记
  deleteNote() {
    this.showMenuDialog = false;
    this.showConfirmDialog = true;
    this.updateInputState(false);
  },
  
  // 取消菜单
  cancelMenu() {
    this.showMenuDialog = false;
    this.updateInputState(true);
  },
  
  // 取消删除
  cancelDelete() {
    this.showConfirmDialog = false;
    this.updateInputState(true);
  },
  
  // 确认删除
  confirmDelete() {
    this.showConfirmDialog = false;
    this.deleteNoteFromFile();
  },
  
  // 从文件中删除笔记
  deleteNoteFromFile() {
    try {
      import('../Common/utils.js').then(utils => {
        utils.readMetadata((err, metadata) => {
          if (err) {
            console.error("读取元数据失败:", err);
            this.handleDeleteComplete();
            return;
          }
          
          let noteId = null;
          
          // 如果是编辑模式，尝试使用原始笔记ID
          if (this.index >= 0) {
            if (this.originalNoteId) {
              noteId = this.originalNoteId;
            } else {
              // 获取笔记ID列表并排序
              const noteIds = Object.keys(metadata.notes || {}).sort((a, b) => {
                return metadata.notes[b].createTime - metadata.notes[a].createTime;
              });
              
              // 使用原始索引删除笔记
              if (this.index >= 0 && this.index < noteIds.length) {
                noteId = noteIds[this.index];
              }
            }
          } else {
            // 如果是新笔记，使用原始笔记ID
            noteId = this.originalNoteId;
          }
          
          if (noteId && metadata.notes[noteId]) {
            // 删除笔记文件
            utils.deleteNoteFile(noteId, (err) => {
              if (err) {
                console.error("删除笔记文件失败:", err);
              }
              
              // 从元数据中移除笔记信息
              delete metadata.notes[noteId];
              
              // 保存更新后的元数据
              utils.saveMetadata(metadata, (err) => {
                if (err) {
                  console.error("更新元数据失败:", err);
                }
                this.handleDeleteComplete();
              });
            });
          } else {
            console.warn("笔记ID未找到或笔记不存在");
            this.handleDeleteComplete();
          }
        });
      });
    } catch (error) {
      console.error("删除笔记时发生异常:", error);
      this.handleDeleteComplete();
    }
  },
  
  // 处理删除完成
  handleDeleteComplete() {
    // 关闭确认对话框
    this.showConfirmDialog = false;
    // 显示删除成功提示
    prompt.showToast({
      message: '删除成功'
    });
    // 删除后清除恢复文件完成再返回主页面，避免 index 残留恢复笔记
    this.clearRecoveryFileThen(() => {
      // 通知index页面笔记已更改
      notifyNotesChange();
      setTimeout(() => {
        router.back();
      }, 500);
    });
  },
  
  // 取消退出
  cancelExit() {
    this.showExitConfirm = false;
    this.updateInputState(true);
  },
  
  // 确认退出
  confirmExit() {
    this.showExitConfirm = false;
    // 清除恢复文件完成后再返回，避免 index 读到残留恢复文件
    this.clearRecoveryFileThen(() => router.back());
  },
  
  // 滚动到底部：仅当光标在末尾且位于当前窗口内
  scrollToBottom() {
    // 光标不在末尾，或已被滚出当前窗口时不跟随，避免把视图拉回
    if (this.cursorPosition < this.textLength()) {
      return;
    }
    if (!this.isCursorInWindow()) {
      return;
    }
    this.scrollTopValue = 2147483647;
    const scrollElement = this.$element("textScroll");
    if (scrollElement) {
      scrollElement.scrollTo({
        top: 2147483647,//最大安全整数
        behavior: 'auto'
      });
    }
  },
  
  scrollToTop() {
    // 分段渲染下，先把窗口重置到文档开头
    const doc = this.__doc;
    if (doc) {
      this.buildWindow(0);
      this.refreshSlices();
    }
    this.scrollTopValue = 0;
    this.currentScrollTop = 0;
    const scrollElement = this.$element("textScroll");
    if (scrollElement) {
      this.$nextTick(() => {
        scrollElement.scrollTo({
          top: 0,
          behavior: 'auto'
        });
      });
    }
  },

  // 滚动事件：记录位置（模板里原本 @scroll 指向了未定义方法）
  onScroll(e) {
    if (e && typeof e.scrollY === 'number') {
      this.currentScrollTop = e.scrollY;
      this.scrollTopValue = e.scrollY;
    }
  },

  // 滚到窗口顶部：向上翻一段
  onScrollTop() {
    if (this.scrollWait) return;
    this.shiftWindowBackward();
  },

  // 滚到窗口底部：向下翻一段
  onScrollBottom() {
    if (this.scrollWait) return;
    this.shiftWindowForward();
  },

  // 窗口向下平移一段：移除顶部段，用其测得高度补偿滚动
  shiftWindowForward() {
    const doc = this.__doc;
    if (!doc || this.winEnd >= doc.chunks.length - 1) return;
    this.scrollWait = true;
    const before = this.currentScrollTop;
    const el = this.$element('chunkWrap0');
    const finish = (h) => {
      const nt = Math.max(0, before - (h || 0));
      // 窗口与滚动量同一次赋值，交给框架合并成一次渲染
      this.winStart++;
      this.winEnd++;
      this.scrollTopValue = nt;
      this.currentScrollTop = nt;
      this.refreshSlices();
      this.$nextTick(() => {
        setTimeout(() => {
          const sc = this.$element('textScroll');
          if (sc) sc.scrollTo({ top: nt, behavior: 'auto' });
          this.scrollWait = false;
        }, 60);
      });
    };
    if (el) {
      el.getBoundingClientRect({
        success: (rect) => finish(rect.height),
        fail: () => finish(0)
      });
    } else {
      finish(0);
    }
  },

  // 窗口向上平移一段：前插一段，用原首段高度近似补偿滚动
  shiftWindowBackward() {
    const doc = this.__doc;
    if (!doc || this.winStart <= 0) return;
    this.scrollWait = true;
    const before = this.currentScrollTop;
    const el = this.$element('chunkWrap0');
    const apply = (h) => {
      const nt = before + (h || 0);
      // 窗口与滚动量同一次赋值，交给框架合并成一次渲染
      this.winStart--;
      this.winEnd--;
      this.scrollTopValue = nt;
      this.currentScrollTop = nt;
      this.refreshSlices();
      this.$nextTick(() => {
        setTimeout(() => {
          const sc = this.$element('textScroll');
          if (sc) sc.scrollTo({ top: nt, behavior: 'auto' });
          this.scrollWait = false;
        }, 60);
      });
    };
    if (el) {
      el.getBoundingClientRect({
        success: (rect) => apply(rect.height),
        fail: () => apply(0)
      });
    } else {
      apply(0);
    }
  },
  
  // 检查并保存恢复文件（仅在有改动时）
  checkAndSaveRecovery() {
    if (!this.__doc) return;
    if (!this._recoveryDirty) return;
    this.saveRecoveryFile();
  },
  
  // 保存恢复文件：逐段 append 写入，避免拼出整串
  saveRecoveryFile() {
    if (!this.__doc) return;
    if (this._recoveryWriting) return;
    if (this.isSaving) return;
    this._recoveryWriting = true;
    writeChunks('internal://files/recovery.txt', this.__doc.chunks, (err) => {
      this._recoveryWriting = false;
      if (err) {
        console.error("保存恢复文件失败:", err);
        return;
      }
      this._recoveryDirty = false;
      console.log("恢复文件 recovery.txt 保存成功");
    });
  },
  
  // 清除恢复文件完成后再执行回调，确保异步删除完成后再离开页面/刷新，
  // 避免 index 在 onShow 时读到尚未删除的恢复文件而残留“恢复的笔记”。
  clearRecoveryFileThen(done) {
    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      if (typeof done === 'function') done();
    };
    // 兜底：文件模块异常时也不能阻塞离开页面
    setTimeout(finish, 1000);
    import('../Common/utils.js').then(utils => {
      utils.clearRecoveryFile((err) => {
        if (err) {
          console.error("清除恢复文件失败:", err);
        } else {
          console.log("恢复文件 recovery.txt 清除成功");
        }
        finish();
      });
    }).catch((err) => {
      console.error("清除恢复文件时发生异常:", err);
      finish();
    });
  },
  
  // 清除恢复文件（不等待结果，用于页面销毁等兜底场景）
  clearRecoveryFile() {
    this.clearRecoveryFileThen();
  },
}
</script>